      "typeVersion": 1.3,
      "position": [
        800,
        440
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Normalize Input').item.json.sessionId }}",
        "contextWindowLength": 6
      }
    },
    {
      "id": "71468e39-672f-5baa-9b27-21e1205b3e0c",
      "name": "Simulated Slot Check",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "797789c3-878d-5685-b163-3ed767502ac0",
              "name": "reply",
              "value": "={{ $json.output }}",
              "type": "string"
            },
            {
              "id": "a51f7e0c-dcc8-55d1-bddf-362e983f34a8",
              "name": "requestedSlot",
              "value": "={{ $('Normalize Input').item.json.requestedSlot }}",
              "type": "string"
            },
            {
              "id": "7ee0d65a-4393-502c-a19b-e4242634c9a9",
              "name": "sampleOpenSlots",
              "value": "Monday 10:00,Tuesday 14:00,Thursday 09:00",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "cb61e9bc-d222-5d2f-917d-c02a415f4a58",
      "name": "Slot Open?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1180,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "95911c02-3c3e-598b-baa0-12cfb4e54d96",
              "leftValue": "={{ $json.sampleOpenSlots.split(',').includes($json.requestedSlot) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "299ab468-96a3-56cf-bb4c-e1c3e6b10ec4",
