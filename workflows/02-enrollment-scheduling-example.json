      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "enrollment-example",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "fe0049bd-3ffd-54e1-8c5b-a5fcf6869886",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e5978b69-72e3-5d84-b8d5-67a7b9f04021",
              "name": "message",
              "value": "={{ String($json.body.message || '').trim() }}",
              "type": "string"
            },
            {
              "id": "b5d7c18e-ba66-5911-8495-4c6cdea1dc37",
              "name": "sessionId",
              "value": "={{ String($json.body.sessionId || 'demo-session') }}",
              "type": "string"
            },
            {
              "id": "ec63377f-9790-5f36-9c3b-cba872464624",
              "name": "requestedSlot",
              "value": "={{ String($json.body.requestedSlot || '') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "06ccd980-821c-5a30-804e-59096f4c562b",
      "name": "Route by Topic",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        440,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "aec0c786-55f9-56c6-a58d-aac6f9f647f7",
                    "leftValue": "={{ $json.message }}",
                    "rightValue": "enroll",
                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "enrollment"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "cd5aee93-b292-56ab-b3c8-c6ecea577b5c",
                    "leftValue": "={{ $json.message }}",
                    "rightValue": "visit",
                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "visit"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "other"
        }
      }
    },
    {
      "id": "ebc8be29-fea8-5f49-b4b8-13021378d86d",
      "name": "Admissions Assistant",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        700,
        200
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Normalize Input').item.json.message }}",
        "options": {
          "systemMessage": "You are a helpful assistant for a fictional school called Example Academy. Help families with enrollment questions and visit requests. Ask for the child's age group and a preferred time slot, one question at a time. Keep answers short and polite."
        }
      }
    },
    {
      "id": "4b93c8b4-cd3c-51e7-9045-b6d0e011e62c",
      "name": "Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        600,
        440
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.3
        }
      }
    },
    {
      "id": "d2b86246-e9d7-563e-a0ab-f4b46c7c1f20",
      "name": "Conversation Memory",
